# Set to true to run against in-memory fakes: no Circle account, no deployed contracts.
# Every field below is ignored in that mode.
STUB_MODE=false


# Testnet convenience: move this much USDC from the operating wallet to each new renter so
# they can dispatch a job without visiting a faucet. Leave empty to disable.
SEED_RENTER_USDC=

# Circle developer-controlled wallets
CIRCLE_API_KEY=
# Written by `npm run register-entity-secret`. Move to a secrets manager for production.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_NAME=canopy
# Printed by `npm run provision`
CIRCLE_WALLET_SET_ID=

# Chain
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Arc exposes USDC twice: a native 18-decimal gas token and a 6-decimal ERC-20 at
# 0x3600000000000000000000000000000000000000. Use the ERC-20 id — the ledger keeps six
# decimals, and gas is paid from the native balance automatically.
CIRCLE_USDC_TOKEN_ID=

# Platform wallets, printed by `npm run provision`
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
OPERATING_WALLET_ID=
OPERATING_WALLET_ADDRESS=
REVENUE_WALLET_ID=
REVENUE_WALLET_ADDRESS=


# Marketplace economics
PLATFORM_FEE_BPS=1500
AUTHORIZATION_BUFFER_BPS=13000
OPERATING_FLOAT_CEILING=25000
OPERATING_FLOAT_FLOOR=5000
MINIMUM_DEPOSIT=1
MINIMUM_WITHDRAWAL=5

# Longest run a rental can be billed for. Runtime is measured, so the hold covers this whole
# allowance — raising it lets jobs run longer but demands a larger balance to dispatch.
MAX_BILLABLE_MINUTES=2

PORT=8080
