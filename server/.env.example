# Set to true to run against in-memory fakes: no Circle account, no deployed contracts.
# Every field below is ignored in that mode.
STUB_MODE=false

# Circle developer-controlled wallets
CIRCLE_API_KEY=
# Written by `npm run register-entity-secret`. Move to a secrets manager for production.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_NAME=robot-marketplace
# Printed by `npm run provision`
CIRCLE_WALLET_SET_ID=

# Chain
CIRCLE_BLOCKCHAIN=ARC-TESTNET
ARC_RPC_URL=
CIRCLE_USDC_TOKEN_ID=

# Platform wallets, printed by `npm run provision`
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=
OPERATING_WALLET_ID=
OPERATING_WALLET_ADDRESS=
REVENUE_WALLET_ID=
REVENUE_WALLET_ADDRESS=
SETTLEMENT_OPERATOR_WALLET_ID=

# Deployed contracts
ROBOT_REGISTRY_ADDRESS=
RENTAL_MANAGER_ADDRESS=

# Marketplace economics
PLATFORM_FEE_BPS=1500
AUTHORIZATION_BUFFER_BPS=13000
OPERATING_FLOAT_CEILING=25000
OPERATING_FLOAT_FLOOR=5000
MINIMUM_DEPOSIT=1
MINIMUM_WITHDRAWAL=5

PORT=8080
