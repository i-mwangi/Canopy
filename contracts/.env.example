# Arc testnet RPC endpoint
ARC_RPC_URL=

# Deployer account. Needs a USDC balance — USDC is the native gas token on Arc.
DEPLOYER_PRIVATE_KEY=

# Circle settlement operator wallet address. Granted the operator role after deploy,
# so the server can write the rental lifecycle without holding a key locally.
SETTLEMENT_OPERATOR_ADDRESS=

# Platform fee taken from every settled fare, in basis points. Capped at 3000 on chain.
PLATFORM_FEE_BPS=1500

# Set after deploy, read by the seed script.
ROBOT_REGISTRY_ADDRESS=
RENTAL_MANAGER_ADDRESS=
