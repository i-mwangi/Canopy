MARKETPLACE_API_URL=http://localhost:8080
AGENT_TOKEN=
METER_INTERVAL_SECONDS=15
# Shared with the Webots controllers, which default to this same directory. Relative to where
# the agent is started, so run it from robot-agent/ as the README does.
ROBOT_STATE_DIR=./state
# scenario: drives the vendored simulator through its own server, a leg at a time
# file: drives controllers through a shared state directory, a move at a time
# http: posts directly to a controller endpoint (physical unit behind a tunnel)
ROBOT_BACKEND=scenario

# The simulator's own server, and the assembled controllers it writes state files into.
WEBOTS_SERVER_URL=http://localhost:5000
WEBOTS_SIM_DIR=./sim/controllers
# Which crate the picking robot reaches for: 0 green, 1 blue, 2 purple.
WEBOTS_PRODUCT_ID=0
# How many times a leg is handed over before the order gives up on it. The simulator's
# controllers can drop one, so a single attempt is not enough.
SCENARIO_ATTEMPTS=3

ROBOT_CONTROLLER_URL=http://localhost:5002
# A leg is a whole run of the route, so this is a leg's budget, not a move's.
TASK_TIMEOUT_SECONDS=300
PORT=5001
